# MongoDB Atlas connection string (free tier is fine)
# Get one at https://www.mongodb.com/cloud/atlas -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=agrinexus

# OpenRouter API key -> https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any OpenRouter model id. Free-tier example shown; swap for a paid one if you want better quality.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Used only for OpenRouter's optional attribution headers
APP_URL=http://localhost:5500
